# Copy to .env.local and fill in real values.
# Never commit .env.local or real secrets.

# --- Supabase (required for most apps) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: site / debug ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DEBUG_LOGGING=false

# --- Optional: Spotify (Magic Playlists) ---
# NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000

# --- Optional: AI providers ---
# XAI_API_KEY=
# GROQ_API_KEY=

# --- Dead Pool (/deadpool) ---
# Shared invite code required to register. Server-only — never expose as NEXT_PUBLIC_.
DEADPOOL_INVITE_CODE=
